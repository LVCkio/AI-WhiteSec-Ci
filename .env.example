POSTGRES_DB=ai_whitesec
POSTGRES_USER=ai_whitesec
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://ai_whitesec:change-me@postgres:5432/ai_whitesec
INFERENCE_URL=http://inference:8001
MODEL_VERSION=mock-codebert-5cwe-v1
MODEL_MODE=mock
AI_CONFIDENCE_THRESHOLD=0.70
DATASET_ROOT=D:/Do an tot nghiep/dataset do an/Dataset_PyVul/data/pilot-5cwe-v2

# ── Backend security ────────────────────────────────────────────────────────
# Leave API_KEY empty to disable authentication (local dev only).
# Set to a strong random secret before deploying to the VPS.
API_KEY=

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── CodeBERT inference (only needed when MODEL_MODE=codebert) ───────────────
# Path to the fine-tuned checkpoint directory (must contain label_map.json,
# thresholds.json, model_meta.json, and the HuggingFace model files).
CHECKPOINT_DIR=
CODEBERT_MAX_LENGTH=512
